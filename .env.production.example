# Production environment template for piotrack.com
# Copy to your host's secret store / .env — NEVER commit the filled-in file.
# Generate APP_KEY with:  php artisan key:generate --show

APP_NAME=Piotrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://piotrack.com
APP_VERSION=  # set by CI to the release tag / commit SHA

# Force HTTPS is handled in code for production; keep the URL https above.
ASSET_URL=https://piotrack.com

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_LEVEL=warning

# --- Database (managed PostgreSQL 16) ---
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=piotrack
DB_USERNAME=
DB_PASSWORD=
# Most managed Postgres providers require TLS:
DB_SSLMODE=require

# --- Cache / queue / sessions (Redis) ---
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.piotrack.com
# Cookies must only travel over HTTPS in production:
SESSION_SECURE_COOKIE=true

# Sanctum stateful domains for first-party SPA/API auth:
SANCTUM_STATEFUL_DOMAINS=piotrack.com,www.piotrack.com

# --- Mail (transactional email — required for verification & password reset) ---
# Use a real provider in production (SES / Postmark / Mailgun / SendGrid).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@piotrack.com
MAIL_FROM_NAME="Piotrack"
